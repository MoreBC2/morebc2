---
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Page not found | MoreBC2</title>
    <style>
      :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
      body { display: grid; min-height: 100vh; margin: 0; place-items: center; background: #10131a; color: #f4f6fb; }
      main { max-width: 36rem; padding: 2rem; text-align: center; }
      h1 { margin-block: 0 0.75rem; font-size: clamp(2rem, 8vw, 4rem); }
      p { color: #c5cada; line-height: 1.6; }
      a { color: #a9c7ff; }
      a:focus-visible { outline: 3px solid currentColor; outline-offset: 0.25rem; }
      @media (prefers-color-scheme: light) {
        body { background: #fff; color: #15171c; }
        p { color: #4b5262; }
        a { color: #2457a6; }
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Page not found</h1>
      <p>The requested MoreBC2 page does not exist.</p>
      <p><a href="/">Return to the MoreBC2 homepage</a></p>
    </main>
  </body>
</html>
